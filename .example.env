# Local fake mode. No Instagram messages or model requests are sent.
# Copy to .env only if you do not already have a real configuration.
BLOTATO_MODE=fake
BLOTATO_LISTEN=127.0.0.1:8080
BLOTATO_DB=blotato.db
SWAGGER_BASE_PATH=/

# Required at startup. This synthetic value works only with Jev disabled.
BLOTATO_EMAIL_INTENT_ENABLED=false
OPENROUTER_API_KEY=local-demo-unused

# Instagram mode only: use your own Unified Login credentials.
INSTAGRAM_API_BASE=https://graph.facebook.com/v26.0
INSTAGRAM_REQUEST_TIMEOUT=10s
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
BLOTATO_ADMIN_TOKEN=
