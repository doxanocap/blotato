{
    "swagger": "2.0",
    "info": {
        "description": "Обработка комментариев и сообщений Instagram.",
        "title": "Blotato API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/workflows": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "В Instagram-режиме требуется Bearer BLOTATO_ADMIN_TOKEN; в fake авторизация не требуется.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Получить правила",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Workflow"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "В Instagram-режиме требуется Bearer BLOTATO_ADMIN_TOKEN; в fake авторизация не требуется.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Создать правило обработки комментариев",
                "parameters": [
                    {
                        "description": "Параметры правила",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/workflows.postWorkflowReq"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.Workflow"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    }
                }
            }
        },
        "/api/v1/workflows/runs": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Каждая строка содержит выполнение и одно его действие. В Instagram-режиме требуется Bearer BLOTATO_ADMIN_TOKEN; в fake авторизация не требуется.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Получить состояния выполнений",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Run"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    }
                }
            }
        },
        "/events": {
            "post": {
                "description": "Только fake-режим. Ответ 202 возвращается после сохранения; повтор известного события безопасен. Для отправки ссылки нужен occurred_at сообщения.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "fake"
                ],
                "summary": "Принять тестовое событие",
                "parameters": [
                    {
                        "description": "Входящее событие",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/workflows.postEventReq"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Событие сохранено или уже получено"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    }
                }
            }
        },
        "/fake/outcome": {
            "post": {
                "description": "Только fake-режим. Не отправляет сообщения в Instagram.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "fake"
                ],
                "summary": "Задать исход тестовой отправки",
                "parameters": [
                    {
                        "description": "Шаг и исход",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/workflows.postFakeOutcomeReq"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Исход установлен"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    }
                }
            }
        },
        "/webhook/instagram": {
            "get": {
                "description": "Только Instagram-режим. Проверка challenge не подтверждает доставку реальных событий.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "instagram"
                ],
                "summary": "Подтвердить подключение webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "subscribe",
                        "name": "hub.mode",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Verify token, настроенный на сервере",
                        "name": "hub.verify_token",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Challenge Meta",
                        "name": "hub.challenge",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Исходный challenge",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    }
                }
            },
            "post": {
                "description": "Только Instagram-режим. HMAC-SHA256 проверяется по исходному телу. События сохраняются последовательно; при 503 повтор пакета безопасен благодаря дедупликации сервиса. Служебные события и эхо игнорируются.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "instagram"
                ],
                "summary": "Принять события Instagram",
                "parameters": [
                    {
                        "type": "string",
                        "description": "sha256=\u003cHMAC исходного тела\u003e",
                        "name": "X-Hub-Signature-256",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Уведомление Meta",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/workflows.postInstagramWebhookReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Все значимые события сохранены или уже получены"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/errs.HTTPError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "errs.HTTPError": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                }
            }
        },
        "models.Run": {
            "type": "object",
            "properties": {
                "action_error": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                },
                "run_id": {
                    "type": "integer"
                },
                "state": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "step": {
                    "type": "string"
                }
            }
        },
        "models.Workflow": {
            "type": "object",
            "properties": {
                "email_question": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "keyword": {
                    "type": "string"
                },
                "link": {
                    "type": "string"
                },
                "public_reply": {
                    "type": "string"
                }
            }
        },
        "types.ActionStep": {
            "type": "string",
            "enum": [
                "reply_comment",
                "ask_email",
                "send_link"
            ],
            "x-enum-varnames": [
                "ReplyComment",
                "AskEmail",
                "SendLink"
            ]
        },
        "types.EventType": {
            "type": "string",
            "enum": [
                "comment",
                "message"
            ],
            "x-enum-varnames": [
                "Comment",
                "Message"
            ]
        },
        "types.SendOutcome": {
            "type": "string",
            "enum": [
                "accepted",
                "retryable",
                "rejected",
                "unknown"
            ],
            "x-enum-varnames": [
                "Accepted",
                "Retryable",
                "Rejected",
                "Unknown"
            ]
        },
        "workflows.postEventReq": {
            "type": "object",
            "properties": {
                "account_id": {
                    "type": "string",
                    "example": "brand"
                },
                "contact_id": {
                    "type": "string",
                    "example": "person"
                },
                "event_id": {
                    "type": "string",
                    "example": "c1"
                },
                "kind": {
                    "enum": [
                        "comment",
                        "message"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/types.EventType"
                        }
                    ]
                },
                "occurred_at": {
                    "type": "string"
                },
                "platform": {
                    "type": "string",
                    "example": "fake"
                },
                "text": {
                    "type": "string",
                    "example": "pricing"
                }
            }
        },
        "workflows.postFakeOutcomeReq": {
            "type": "object",
            "properties": {
                "outcome": {
                    "enum": [
                        "accepted",
                        "retryable",
                        "rejected",
                        "unknown"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/types.SendOutcome"
                        }
                    ]
                },
                "step": {
                    "enum": [
                        "reply_comment",
                        "ask_email",
                        "send_link"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/types.ActionStep"
                        }
                    ]
                }
            }
        },
        "workflows.postInstagramWebhookReq": {
            "type": "object",
            "properties": {
                "entry": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/workflows.webhookEntry"
                    }
                },
                "object": {
                    "type": "string"
                }
            }
        },
        "workflows.postWorkflowReq": {
            "type": "object",
            "properties": {
                "email_question": {
                    "type": "string",
                    "example": "What is your email address?"
                },
                "keyword": {
                    "type": "string",
                    "example": "pricing"
                },
                "link": {
                    "type": "string",
                    "example": "https://example.com/pricing"
                },
                "public_reply": {
                    "type": "string",
                    "example": "Sent you a DM!"
                }
            }
        },
        "workflows.webhookChange": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "value": {
                    "$ref": "#/definitions/workflows.webhookComment"
                }
            }
        },
        "workflows.webhookComment": {
            "type": "object",
            "properties": {
                "from": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "id": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                }
            }
        },
        "workflows.webhookEntry": {
            "type": "object",
            "properties": {
                "changes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/workflows.webhookChange"
                    }
                },
                "field": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "messaging": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/workflows.webhookMessage"
                    }
                },
                "value": {
                    "$ref": "#/definitions/workflows.webhookComment"
                }
            }
        },
        "workflows.webhookMessage": {
            "type": "object",
            "properties": {
                "is_self": {
                    "type": "boolean"
                },
                "message": {
                    "type": "object",
                    "properties": {
                        "is_deleted": {
                            "type": "boolean"
                        },
                        "is_echo": {
                            "type": "boolean"
                        },
                        "is_self": {
                            "type": "boolean"
                        },
                        "is_unsupported": {
                            "type": "boolean"
                        },
                        "mid": {
                            "type": "string"
                        },
                        "text": {
                            "type": "string"
                        }
                    }
                },
                "recipient": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "sender": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "timestamp": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "Bearer token; обязателен в Instagram-режиме.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}